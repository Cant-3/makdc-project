# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# DATABASE
# ============================================
# Kwa local development (kama una PostgreSQL):
DATABASE_URL="postgresql://postgres:password@localhost:5432/makdc_db"

# Kwa Railway (production — nakala kutoka Railway):
# DATABASE_URL="postgresql://postgres:password@containers-us-west-xxx.railway.app:1234/railway"

# ============================================
# AUTHENTICATION
# ============================================
# Weka secret ndefu — angalau 64 characters random!
# Unaweza kutengeneza hapa: https://randomkeygen.com/
JWT_SECRET="badilisha-hii-na-secret-ndefu-random-64-characters-au-zaidi-2026"
JWT_EXPIRES_IN=7d

# ============================================
# EMAIL (SMTP) — Baadaye tutaunganisha
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="MAK DC Investment <noreply@makdc.co.tz>"

# ============================================
# SMS — Baadaye tutaunganisha
# ============================================
SMS_API_KEY=
SMS_SENDER_ID=MAKDC

# ============================================
# FRONTEND URL (kwa CORS)
# ============================================
FRONTEND_URL=http://localhost:3000